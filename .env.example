# ==============================================================================
# ESCENAS VIRALES STUDIO - configuración de entorno
# Copia este archivo a ".env" y rellena los valores. Nunca subas el ".env" real.
# ==============================================================================

# --- Base de datos (SQLite por defecto, funciona sola con Docker) -----------
DATABASE_URL="file:./storage/app.db"

# --- Acceso a la app -----------------------------------------------------
# La app sube vídeos a tus cuentas: NO la dejes abierta a cualquiera en internet.
# Pon aquí una contraseña y se pedirá al entrar (login simple de un solo usuario).
APP_PASSWORD="cambia-esto-por-una-contraseña-fuerte"
# Clave aleatoria larga para firmar la cookie de sesión (genera una con: openssl rand -hex 32)
SESSION_SECRET="cambia-esto-por-una-cadena-aleatoria-larga"

# URL pública donde correrá la app (se usa para construir las URLs de OAuth callback)
# En local: http://localhost:3000  |  En producción: https://tudominio.com
APP_URL="http://localhost:3000"

# ==============================================================================
# ¿QUIERES QUE NO TE CUESTE NADA? Pon estas dos líneas y salta al apartado de
# YouTube/TikTok:
#     AI_PROVIDER="groq"          (o "gemini" si NO estás en la UE/Reino Unido/Suiza)
#     TRANSCRIPTION_PROVIDER="local"
# ==============================================================================

# --- Proveedor de IA para analizar el vídeo y elegir los mejores momentos ---
# Pon la clave de CUALQUIERA de estos que tengas (puedes poner varias a la vez) y la app las
# encadena SOLA de mejor a peor calidad: si la mejor configurada se queda sin cupo (o falla por
# lo que sea), prueba automáticamente con la siguiente sin que tengas que hacer nada — así el
# límite diario de una sola capa gratuita deja de ser un techo real. AI_PROVIDER de abajo ya NO
# decide el orden (antes sí); solo sirve para ajustar el tamaño de petición por defecto.
#
# De mejor a peor calidad (todas menos las dos últimas tienen capa gratuita):
# "gemini"    -> Google Gemini. TIENE CAPA GRATUITA, PERO NO está disponible en la Unión
#                Europea, Reino Unido ni Suiza (Google exige tarjeta ahí por el RGPD/Reglamento
#                de IA europeo). Si no estás en esa zona: https://aistudio.google.com/apikey
# "groq"      -> TIENE CAPA GRATUITA, sin tarjeta, sin restricción geográfica conocida.
#                Consigue la clave gratis en https://console.groq.com/keys
# "cerebras"  -> TIENE CAPA GRATUITA, sin tarjeta (compruébalo tú mismo al crear la cuenta, puede
#                cambiar). Consigue la clave en https://cloud.cerebras.ai
# "mistral"   -> TIENE CAPA GRATUITA, sin tarjeta (compruébalo tú mismo al crear la cuenta, puede
#                cambiar). Consigue la clave en https://console.mistral.ai
# "anthropic" -> Claude. DE PAGO por uso, la mejor calidad de análisis — solo se usa si pones esta
#                clave Y se agotan todas las gratuitas de arriba.
# "openai"    -> GPT. DE PAGO por uso — igual que Claude, último recurso.
AI_PROVIDER="groq"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

GROQ_API_KEY=""
# gpt-oss-20b para texto: además de ser más rápido, es el único al que Groq deja bajarle de
# verdad el esfuerzo de razonamiento (menos tokens gastados "pensando" antes de responder), algo
# necesario porque la capa gratuita de Groq limita a 200.000 tokens AL DÍA (no solo por minuto).
GROQ_MODEL="openai/gpt-oss-20b"
# Modelo con visión aparte para clasificar fotogramas (modo Rankings/Canción): gpt-oss-20b no ve
# imágenes, así que esas peticiones concretas siguen usando este modelo en su lugar.
GROQ_VISION_MODEL="qwen/qwen3.6-27b"

CEREBRAS_API_KEY=""
CEREBRAS_MODEL="llama-3.3-70b"
# Si tu cuenta de Cerebras no tiene ningún modelo con visión disponible, las peticiones con
# fotogramas (modo Rankings) fallarán aquí y pasarán solas al siguiente proveedor de la cadena.
CEREBRAS_VISION_MODEL="llama-3.3-70b"

MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-small-latest"
MISTRAL_VISION_MODEL="pixtral-12b-2409"

# Último eslabón, sin clave ni cuenta: un modelo abierto (Ollama) corriendo en el propio
# servidor — solo se usa si TODOS los proveedores de arriba fallan a la vez. En el workflow
# "Servidor temporal" (server.yml) se instala y activa solo, no hace falta tocar nada aquí. Si
# quieres probarlo en local, instala Ollama (https://ollama.com), haz "ollama pull llama3.2:3b"
# y "ollama pull moondream", y pon OLLAMA_ENABLED="true".
OLLAMA_ENABLED="false"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:3b"
OLLAMA_VISION_MODEL="moondream"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

OPENAI_API_KEY=""
OPENAI_ANALYSIS_MODEL="gpt-4o"

# --- Transcripción del audio -------------------------------------------------
# "local"  -> Transcribe en tu propio servidor con faster-whisper. GRATIS, sin
#             claves, sin límite de tamaño. Solo consume CPU (es más lento).
# "openai" -> Usa la API de Whisper de OpenAI. De pago, pero más rápido.
TRANSCRIPTION_PROVIDER="openai"

# Solo si TRANSCRIPTION_PROVIDER="local":
# tiny | base | small | medium | large-v3  (más grande = transcribe mejor y tarda más)
LOCAL_WHISPER_MODEL="base"
PYTHON_PATH="python3"

# Solo si TRANSCRIPTION_PROVIDER="openai":
OPENAI_API_KEY_WHISPER=""
WHISPER_MODEL="whisper-1"

# --- Comentario/reacción narrado con IA (voz en off) -------------------------
# Envuelve cada short con una intro y un cierre narrados por IA (tarjeta de texto
# sobre fondo negro), con tu propia opinión/reacción. Ayuda a que el vídeo cuente
# como contenido transformado y no como una simple copia (ver aviso legal en el
# README: esto reduce el riesgo, no lo elimina). DESACTIVADO por defecto: un short
# profesional entra directo a la acción, sin pantalla negra al principio.
ENABLE_COMMENTARY="false"

# --- Subtítulos quemados en el vídeo ------------------------------------------
# Activado por defecto: mejora mucho la retención (se entiende sin sonido).
ENABLE_SUBTITLES="true"

# --- Voz para el comentario narrado -------------------------------------------
# "local"  -> Piper, GRATIS, sin claves, corre en tu propio servidor (voz robótica
#             pero muy decente). Descarga la voz elegida la primera vez (~60 MB).
# "openai" -> API de voz de OpenAI. De pago, pero voz mucho más natural.
TTS_PROVIDER="local"

# Solo si TTS_PROVIDER="local". Si no la pones, se elige sola según CHANNEL_LANGUAGE
# (inglés -> en_US-lessac-medium, español -> es_ES-davefx-medium). Catálogo completo
# de voces: https://github.com/OHF-voice/piper1-gpl
LOCAL_TTS_VOICE=""

# Solo si TTS_PROVIDER="openai":
OPENAI_API_KEY_TTS=""
OPENAI_TTS_VOICE="alloy"
OPENAI_TTS_MODEL="tts-1"

# --- YouTube (Google Cloud Console -> APIs & Servicios -> Credenciales) -----
# 1. Crea un proyecto en https://console.cloud.google.com
# 2. Activa "YouTube Data API v3"
# 3. Crea credenciales OAuth 2.0 de tipo "Aplicación web"
# 4. Añade como URI de redirección: {APP_URL}/api/auth/youtube/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- TikTok (https://developers.tiktok.com -> Manage apps) -----------------
# 1. Crea una app y activa el producto "Login Kit" y "Content Posting API"
# 2. Mientras tu app no esté auditada por TikTok, el "Content Posting API"
#    solo permite subir vídeos como BORRADOR PRIVADO a tu propia cuenta
#    (tú los publicas manualmente desde la app de TikTok). Esta app ya lo
#    gestiona así automáticamente.
# 3. Añade como URI de redirección: {APP_URL}/api/auth/tiktok/callback
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# --- Descarga de vídeo fuente ------------------------------------------------
# Ruta al binario de yt-dlp (ya viene instalado en la imagen Docker)
YTDLP_PATH="yt-dlp"
FFMPEG_PATH="ffmpeg"
# Servicio que evita que YouTube bloquee las descargas con "Sign in to confirm you're not a
# bot" (típico en IPs de servidor/datacenter). Con Docker Compose ya viene levantado como
# servicio "bgutil-provider" — deja esta línea tal cual. Solo cámbiala si lo ejecutas de otra
# forma (fuera de Docker Compose, con el proveedor corriendo en otra máquina, etc.).
BGUTIL_POT_BASE_URL="http://bgutil-provider:4416"

# --- Pipeline ---------------------------------------------------------------
# Techo de shorts por vídeo fuente. La cantidad real que se pide a la IA depende de la
# duración del vídeo (aprox. 1 short cada 2 minutos: un vídeo de 50 min apunta a ~25,
# uno de 10 min a ~5), y este valor solo pone un límite máximo para que vídeos muy largos
# no disparen el número de peticiones/render. Cuantos más shorts, más tarda el trabajo
# (más cortes de ffmpeg y, si ENABLE_COMMENTARY="true", más llamadas a la IA y a texto-a-voz).
MAX_CLIPS_PER_JOB="40"
# Duración mínima/máxima de cada short en segundos (1 min - 3 min)
CLIP_MIN_SECONDS="60"
CLIP_MAX_SECONDS="180"
# Cada cuántos segundos el worker revisa si hay trabajos pendientes en la cola
WORKER_POLL_INTERVAL_MS="4000"

# --- Identidad del canal (se usa para adaptar títulos/descripciones/hashtags) -
CHANNEL_NAME="Escenas Virales"
CHANNEL_NICHE="Recopilación de las mejores escenas virales de creadores de contenido"
# Idioma de TODO el texto que genera la IA (títulos, descripciones, hashtags, comentario en off).
# Por defecto en inglés: suele dar más ingresos publicitarios (CPM más alto) que el español.
# Pon cualquier código de idioma ("es", "fr", "pt"...); también elige la voz de Piper por defecto.
# Esto NO afecta al audio original de los vídeos fuente: nunca se traduce ni se dobla, se usa tal
# cual venga (si el vídeo ya está en inglés, se queda en inglés igualmente).
CHANNEL_LANGUAGE="en"

# --- Modo Rankings (vídeos de recopilación tipo "top 5 fails de...") ---------
# Mínimo/máximo de momentos que debe tener una categoría para generar un vídeo de ranking. Máximo
# 5 (tope duro, nunca se supera), mínimo 3 (suelo duro, por debajo se descarta el grupo) — lo
# normal/preferido es siempre 5, y solo baja a 4 o 3 cuando 5 no es posible con ese material.
RANKING_MIN_ITEMS="3"
RANKING_MAX_ITEMS="5"
# Cada cuántos segundos se busca un posible corte de escena (detección de silencios)
RANKING_MIN_SEGMENT_SECONDS="3"

# --- Modo Canción (remontar una recopilación al ritmo de una canción) --------
# Duración máxima (en segundos) del vídeo final del modo Canción
SONG_MAX_DURATION_SEC="60"

# --- Programación automática de publicaciones --------------------------------
# Cada cuántos minutos el worker revisa si toca auto-publicar algo (según Ajustes -> Programación)
SCHEDULER_POLL_INTERVAL_MS="60000"
# Zona horaria del servidor: las franjas horarias de Ajustes -> Programación se interpretan en esta zona.
TZ="Europe/Madrid"
