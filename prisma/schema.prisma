generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Modo Estudia: vídeos tipo "Draw My Life" generados por la IA a partir de los apuntes.
// "script" es el guion completo en JSON (escenas animadas que se reproducen en el navegador).
// "seen" sirve para que «Para ti» no repita hasta haberlos visto todos una vez.
model StudyVideo {
  id        String   @id @default(cuid())
  subject   String
  topic     String
  title     String
  order     Int      @default(0)
  script    String
  seen      Boolean  @default(false)
  liked     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([subject])
}

// Claves de proveedores de IA pegadas desde Ajustes (ver src/lib/ai/credentials.ts).
model AiCredential {
  provider  String   @id // "gemini" | "groq" | "cerebras" | "mistral" | "anthropic" | "openai"
  apiKey    String
  updatedAt DateTime @updatedAt
}
