generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite no soporta enums nativos en Prisma: los estados se validan como
// strings a nivel de aplicación (ver src/lib/types.ts).
// Job.mode: SINGLE | RANKING | PRODUCT | SONG | SPLIT | DOUBLE
// JobStatus: PENDING | DOWNLOADING | TRANSCRIBING | ANALYZING | CLIPPING | DONE | FAILED
// ClipStatus: PENDING | RENDERING | READY | FAILED
// Platform: YOUTUBE | TIKTOK
// PublicationStatus: PENDING | UPLOADING | PUBLISHED | DRAFT | FAILED
// AutoPublishSettings.mode: OFF | INTERVAL | WINDOW
// AutoPublishTask.status: PENDING | DONE | FAILED

model Job {
  id                String   @id @default(cuid())
  mode              String   @default("SINGLE")
  sourceUrl         String? // SINGLE/RANKING: vídeo a procesar. SONG: vídeo de recopilación a re-editar.
  sourceTitle       String?
  sourceDurationSec Float?
  status            String   @default("PENDING")
  statusMessage     String?
  error             String?
  transcript        String?
  sourceFilePath    String?
  // Idioma detectado por Whisper en el audio del vídeo fuente (código ISO 639-1, p.ej. "en"/"es").
  // SINGLE/RANKING/SPLIT lo rellenan tras transcribir y lo usan para que título/descripción/
  // hashtags/subtítulos/comentario salgan en ESE idioma en vez del idioma fijo del canal. null si
  // no se pudo detectar (o en PRODUCT/SONG, que no transcriben diálogo del vídeo fuente).
  contentLanguage   String?

  // Solo modo PRODUCT
  productName    String?
  productLink    String? // enlace de afiliado/producto que se añade a la descripción
  referenceAdUrl String? // vídeo de un anuncio existente, usado solo como inspiración de estructura (no se copia)

  // Solo modo SONG
  songUrl String? // vídeo de YouTube de la canción con la que se re-edita el vídeo

  // Solo modo SPLIT: duración fija (segundos) de cada trozo al cortar el vídeo en shorts secuenciales
  splitDurationSec Int?

  // Solo modo DOUBLE ("pantalla dividida"): sourceUrl/sourceFilePath es el vídeo de ARRIBA (el que
  // se corta en partes), bottomVideoUrl/bottomVideoFilePath es el vídeo de ABAJO (p.ej. gameplay de
  // coche) que se repite/continúa a lo largo de todas las partes, y doublePartsCount es en cuántas
  // partes se corta el vídeo de arriba (a diferencia de SPLIT, aquí se pide un NÚMERO de partes, no
  // una duración fija por trozo).
  bottomVideoUrl      String?
  bottomVideoFilePath String?
  doublePartsCount    Int?

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  clips        Clip[]
  productAssets ProductAsset[]
}

// Fotos/vídeos del producto subidos por el usuario para el modo PRODUCT, en orden de aparición.
model ProductAsset {
  id       String @id @default(cuid())
  jobId    String
  job      Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  filePath String
  type     String // "image" | "video"
  order    Int
}

model Clip {
  id             String        @id @default(cuid())
  jobId          String
  job            Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rank           Int
  startSec       Float
  endSec         Float
  title          String
  description    String
  hook           String?
  viralityScore  Int
  viralityReason String
  hashtags       String
  status         String        @default("PENDING")
  filePath       String?
  thumbnailPath  String?
  error          String?

  // startSec real usado al cortar (tras el ajuste de hookFrame.ts) — necesario para poder volver
  // a cortar el clip idéntico al regenerar tras una edición, sin repetir la llamada de IA del gancho.
  effectiveStartSec Float?
  // Subtítulos generados (palabra a palabra) ya no se borran tras el render: se guardan aquí como
  // JSON para poder editarlos/borrarlos y volver a generar el vídeo desde el editor.
  // Formato: [{ id, start, end, words: [{start,end,text}], editedText, deleted }]
  captionCues       String    @default("[]")
  // Textos que el usuario añade a mano en el editor (fuente/color/tamaño/posición propios).
  // Formato: [{ id, text, start, end, xPct, yPct, fontName, fontSize, colorHex, uppercase }]
  customTexts       String    @default("[]")

  // Portada (SINGLE/SPLIT): override elegido a mano desde el editor. Si es null, se usa el
  // fotograma/título por defecto (ver coverCard.ts) — RANKING/PRODUCT/SONG no usan portada.
  coverFrameSec Float?
  coverTitle    String?
  // Imagen propia subida desde la fototeca para la portada, en vez de un fotograma del vídeo.
  // Si está puesta, tiene prioridad sobre coverFrameSec.
  coverImagePath String?

  // Subtítulos grandes estilo karaoke: activados por defecto, editable desde el editor. Si es
  // false, no se queman aunque haya captionCues guardadas (se conservan por si se reactiva).
  captionsEnabled Boolean @default(true)

  category       String?
  // Sugerencia de música de la IA (cualquier modo): si cree que el short mejoraría con canción,
  // musicRecommended=true, musicQuery el título/artista sugerido, y musicSuggestedSection un
  // texto libre tipo "1:15-2:00" con la parte de esa canción que mejor pegaría (orientativo, no
  // se valida contra el audio real hasta que el usuario pega el link).
  musicRecommended      Boolean @default(false)
  musicQuery            String?
  musicSuggestedSection String?
  // El usuario decide si aplicar la música sugerida o no — nunca se quema sola.
  musicEnabled   Boolean @default(false)
  musicSourceUrl String?
  musicStartSec  Float?

  // Guion del comentario/reacción narrado con IA que envuelve el clip (transparencia para el usuario)
  commentaryIntro String?
  commentaryOutro String?

  // Solo modo PRODUCT: enlace de afiliado/producto a mostrar en la descripción
  affiliateLink String?

  autoPublishedAt DateTime?
  createdAt       DateTime      @default(now())
  publications    Publication[]
  rankingItems    RankingItem[]
}

// Sub-clips que componen un vídeo de ranking (cuenta atrás), en orden.
model RankingItem {
  id          String @id @default(cuid())
  clipId      String
  clip        Clip   @relation(fields: [clipId], references: [id], onDelete: Cascade)
  position    Int // 1 = el mejor puesto (se muestra el último, efecto cuenta atrás)
  startSec    Float
  endSec      Float
  label       String
  description String
  commentary  String? // frase narrada con IA para la tarjeta de este puesto
}

model Publication {
  id        String   @id @default(cuid())
  clipId    String
  clip      Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  platform  String
  status    String   @default("PENDING")
  remoteId  String?
  remoteUrl String?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialAccount {
  id           String    @id @default(cuid())
  platform     String    @unique
  accountName  String?
  accountId    String?
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  scope        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Fila única de configuración global de publicación automática.
model AutoPublishSettings {
  id                 Int      @id @default(1)
  enabled            Boolean  @default(false)
  mode               String   @default("INTERVAL")
  intervalHours      Float    @default(3)
  platforms          String   @default("[\"YOUTUBE\",\"TIKTOK\"]")
  spreadWithinWindow Boolean  @default(true)
  nextRunAt          DateTime?
  lastWindowKey      String?
  updatedAt          DateTime @updatedAt
}

model ScheduleWindow {
  id          String @id @default(cuid())
  dayOfWeek   Int // 0 = domingo ... 6 = sábado
  startHour   Int
  startMinute Int
  endHour     Int
  endMinute   Int
}

model AutoPublishTask {
  id          String   @id @default(cuid())
  clipId      String
  platform    String
  scheduledAt DateTime
  status      String   @default("PENDING")
  error       String?
  createdAt   DateTime @default(now())
}
